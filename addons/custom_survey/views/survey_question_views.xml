<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_question_form_staff_sales" model="ir.ui.view">
        <field name="name">survey.question.form.staff.sales</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='save_as_nickname']/parent::group" position="after">
                <group invisible="question_type != 'char_box'">
                    <field name="is_staff_sales_search" readonly="is_customer_search or is_product_search or is_product_lines"/>
                    <field name="is_customer_search" readonly="is_staff_sales_search or is_product_search or is_product_lines"/>
                    <field name="is_product_search" readonly="is_staff_sales_search or is_customer_search or is_product_lines"/>
                    <field name="is_product_lines" readonly="is_staff_sales_search or is_customer_search or is_product_search"/>
                    <field name="product_lines_product_question_id"
                           invisible="not is_product_lines"
                           required="is_product_lines"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>